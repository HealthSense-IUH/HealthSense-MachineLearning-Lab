# Data
data/*
!data/sample/
!data/features/
!data/.gitkeep

# Cache đặc trưng của bảo tàng phiên bản (src/v1..v4) — dữ liệu dẫn xuất,
# tự sinh lại trong ~1 phút khi chạy python src/vN/pipeline.py
data/features/museum_*.csv

# Models & Checkpoints
*.pkl
# ...trừ thư mục models/: đây là các hiện vật muốn giữ lại trong repo.
#   healthsense_afib_pipeline.pkl — model triển khai, KHÔNG tái tạo được nữa
#     (script sinh ra nó đã bị gỡ; xem models/README.md)
#   v1..v4.pkl — 4 đời pipeline, mỗi file ~200 KB, kèm thẻ vN.json
!models/*.pkl
*.pth
*.h5
*.keras
*.msgpack
*.ipynb_checkpoints


# Python & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environments
.env
.venv
venv/
ENV/
env.bak/

# IDEs
.vscode/
.idea/
*.swp
.DS_Store

# File tam cua PowerPoint
~$*
