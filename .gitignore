# ---------- data: chỉ commit đặc trưng V4, bảng train V5, sample, README, MANIFEST ----------
data/*
!data/sample/
!data/features/
!data/.gitkeep
!data/README.md
!data/MANIFEST.csv
data/features/v5/*
!data/features/v5/af_features_cosen_ac.csv
data/features/v6/
data/features/v7/

# ---------- models: chỉ commit V4 triển khai và thẻ JSON; pkl V5/V6 lấy theo data/MANIFEST.csv ----------
*.pkl
!models/v4/healthsense_afib_pipeline.pkl
*.joblib
*.pth
*.h5
*.keras
*.msgpack
**/*_retrained.*
**/*_rebuilt.*

# ---------- results: dẫn xuất từ dữ liệu Synapse hoặc quá lớn ----------
results/v5/*.csv
results/v5/*.npy
results/v6/*predictions.csv
results/v6/*verified_streams.csv
results/v6/dev_global_rule*_grid.csv
**/*.log

# ---------- python, môi trường, IDE ----------
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.env
.venv
venv/
.vscode/
.idea/
*.swp
.DS_Store
~$*
*.bak
catboost_info/
third_party/
